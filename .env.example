# eBay API Configuration
# Get your credentials from: https://developer.ebay.com/my/keys
EBAY_APP_ID=your_app_id_here
EBAY_CERT_ID=your_cert_id_here
EBAY_DEV_ID=your_dev_id_here

# eBay Environment: 'sandbox' for testing, 'production' for live data
# Use sandbox credentials with sandbox environment
EBAY_ENVIRONMENT=sandbox

# Anthropic API (optional - for AI-enhanced deal analysis)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# App Configuration
EBAY_MARKETPLACE=EBAY_GB
EBAY_CURRENCY=GBP
