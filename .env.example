# ========================================
# eBay API Configuration
# ========================================
# Get your credentials from: https://developer.ebay.com/my/keys
#
# IMPORTANT: Use the correct credentials for your environment!
# - For sandbox testing: Use "Application Keys (Sandbox)" section
# - For production: Use "Application Keys (Production)" section
#
# HOW TO GET SANDBOX CREDENTIALS:
# 1. Go to https://developer.ebay.com/my/keys
# 2. Sign in to your eBay developer account
# 3. Scroll to "Application Keys (Sandbox)" section
# 4. Copy the following values:
#    - App ID (Client ID) → EBAY_APP_ID
#    - Cert ID (Client Secret) → EBAY_CERT_ID
#    - Dev ID → EBAY_DEV_ID (optional for Browse API)
# 5. Make sure there are NO spaces or extra characters
#
# NOTE: Sandbox credentials are different from production credentials!
# Using production credentials with EBAY_ENVIRONMENT=sandbox will fail.

EBAY_APP_ID=your_app_id_here
EBAY_CERT_ID=your_cert_id_here
EBAY_DEV_ID=your_dev_id_here

# eBay Environment: 'sandbox' for testing, 'production' for live data
# MUST match the credentials you're using above!
EBAY_ENVIRONMENT=sandbox

# ========================================
# Anthropic Claude AI Configuration
# ========================================
# Optional - for AI-enhanced deal analysis using Claude
# Get your API key from: https://console.anthropic.com/
#
# HOW TO GET ANTHROPIC API KEY:
# 1. Go to https://console.anthropic.com/
# 2. Sign in or create an account
# 3. Navigate to "API Keys" section
# 4. Click "Create Key" and copy the key
# 5. Paste it below (starts with 'sk-ant-')
#
# NOTE: This is optional. The app will work without it,
# but you'll get enhanced AI insights with Claude if configured.

ANTHROPIC_API_KEY=your_anthropic_key_here

# ========================================
# App Configuration
# ========================================
# Marketplace and currency settings

# Marketplace options: EBAY_GB, EBAY_US, EBAY_DE, etc.
EBAY_MARKETPLACE=EBAY_GB

# Currency: GBP, USD, EUR, etc.
EBAY_CURRENCY=GBP
